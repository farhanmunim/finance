{
  "name": "uk-finance-tools",
  "version": "1.0.0",
  "description": "UK income tax / take-home pay calculator and mortgage overpayment tool. Static site (vanilla HTML/CSS/JS) for Cloudflare Pages.",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "node scripts/stamp-assets.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "stamp": "node scripts/stamp-assets.mjs",
    "rates:check": "node scripts/update-rates.mjs --check",
    "rates:update": "node scripts/update-rates.mjs --write",
    "serve": "node scripts/serve.mjs"
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
